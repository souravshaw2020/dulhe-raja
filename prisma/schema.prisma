generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  SHERWANI
  KURTA
  PYJAMA
  INDO_WESTERN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TAILORING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Product {
  id                    String            @id @default(cuid())
  name                  String
  description           String?
  category              Category
  fabricType            String
  basePrice             Decimal           @db.Decimal(10, 2)
  allowsCustomTailoring Boolean           @default(true)

  images                ProductImage[]
  variants              ProductVariant[]
  orderItems            OrderItem[]
  cartItems             CartItem[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("products")
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  color           String
  size            String
  sku             String      @unique
  stock           Int         @default(0)
  priceAdjustment Decimal?    @db.Decimal(10, 2)

  orderItems      OrderItem[]
  cartItems       CartItem[]

  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  s3Url     String
  altText   String?
  isPrimary Boolean @default(false)

  @@map("product_images")
}

model CustomTailoringProfile {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String
  customerEmail   String?
  
  // Measurements in inches
  chest           Decimal     @db.Decimal(5, 2)
  waist           Decimal     @db.Decimal(5, 2)
  shoulderWidth   Decimal     @db.Decimal(5, 2)
  armLength       Decimal     @db.Decimal(5, 2)
  kurtaLength     Decimal?    @db.Decimal(5, 2)
  neck            Decimal?    @db.Decimal(5, 2)
  hip             Decimal?    @db.Decimal(5, 2)
  fittingType     String      @default("REGULAR") // SLIM, REGULAR, COMFORT
  notes           String?

  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())

  @@map("custom_tailoring_profiles")
}

model CartItem {
  id         String          @id @default(cuid())
  sessionId  String // Guest session ID or User ID
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("cart_items")
}

model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  customerName  String
  customerEmail String
  customerPhone String
  shippingAddress String
  city          String
  postalCode    String
  
  totalAmount   Decimal        @db.Decimal(10, 2)
  status        OrderStatus    @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  
  items         OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("orders")
}

model OrderItem {
  id                    String                  @id @default(cuid())
  orderId               String
  order                 Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId             String
  product               Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId             String?
  variant               ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  tailoringProfileId    String?
  tailoringProfile      CustomTailoringProfile? @relation(fields: [tailoringProfileId], references: [id], onDelete: SetNull)
  
  quantity              Int
  unitPrice             Decimal                 @db.Decimal(10, 2)

  @@map("order_items")
}

enum NotificationChannel {
  WHATSAPP
  SMS
  BOTH
}

model CustomerSubscriber {
  id            String   @id @default(cuid())
  name          String?
  phone         String   @unique // E.164 format, e.g., +919876543210
  whatsappOptIn Boolean  @default(true)
  smsOptIn      Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("customer_subscribers")
}

enum CampaignType {
  NEW_CATEGORY_ARRIVALS
  COLLECTION
  DISCOUNT_SALE
}

model NotificationCampaign {
  id              String              @id @default(cuid())
  campaignType    CampaignType        @default(NEW_CATEGORY_ARRIVALS)
  category        Category?
  discountPercent Int?
  title           String
  message         String
  imageUrl        String?
  targetUrl       String?
  channel         NotificationChannel @default(BOTH)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  createdAt       DateTime            @default(now())

  @@map("notification_campaigns")
}